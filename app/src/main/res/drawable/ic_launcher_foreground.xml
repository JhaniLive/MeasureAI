<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a measuring crosshair above a ruler line with two endpoints.
  Everything stays within ~31 units of the center, so even a circular launcher mask
  (radius 33 of the 108 canvas) never clips it. Mirrored by tools/render_icon.py.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crosshair ring -->
    <path
        android:pathData="M54,34a11,11 0,1 1,0 22a11,11 0,1 1,0 -22z"
        android:strokeColor="#FF1DE9D0"
        android:strokeWidth="3.5"
        android:fillColor="#00000000" />
    <!-- Crosshair arms -->
    <path
        android:pathData="M54,28v4M54,58v3M35,45h4M69,45h4"
        android:strokeColor="#FF1DE9D0"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- Aim dot -->
    <path
        android:pathData="M54,42a3,3 0,1 1,0 6a3,3 0,1 1,0 -6z"
        android:fillColor="#FFFFFFFF" />

    <!-- Ruler line -->
    <path
        android:pathData="M36,71h36"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- Ticks -->
    <path
        android:pathData="M44,71v-4M49,71v-2.5M54,71v-5M59,71v-2.5M64,71v-4"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
    <!-- Endpoints -->
    <path
        android:pathData="M36,66.5a4.5,4.5 0,1 1,0 9a4.5,4.5 0,1 1,0 -9zM72,66.5a4.5,4.5 0,1 1,0 9a4.5,4.5 0,1 1,0 -9z"
        android:fillColor="#FF1DE9D0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8" />
</vector>
