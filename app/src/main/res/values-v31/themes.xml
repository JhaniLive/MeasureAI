<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the logo on the brand background -->
    <style name="Theme.MeasureAR" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/brand_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_glow</item>
    </style>
</resources>
